---
import '../styles/global.css';
import RankingTable from '../components/RankingTable.astro';
import type { ProjectRow, CreatorRow } from '../components/RankingTable.astro';
import { loadCurrentData, loadLastData } from '../lib/loadData';
import { buildRankMap, computeTrend } from '../lib/trend';

const current = loadCurrentData();
const last = loadLastData();

// Get MXN exchange rate (fallback to 17.5 if not available)
const mxnRate = current.fx.rates['MXN'] || 17.5;

// Build last-rank maps for comparison
const lastProjectMap = buildRankMap(last.rankings.top_projects, (p) => p.name);
const lastCreatorMap = buildRankMap(last.rankings.top_creators, (c) => c.creator);

// Enrich projects with rank + trend + MXN conversion
const projectRows: ProjectRow[] = current.rankings.top_projects.map((p, idx) => ({
  rank: idx + 1,
  ...p,
  mxn: p.currency === 'MXN' ? p.pledged_original : p.usd * mxnRate,
  trend: computeTrend(idx + 1, p.name, lastProjectMap),
}));

// Enrich creators with rank + trend
const creatorRows: CreatorRow[] = current.rankings.top_creators.map((c, idx) => ({
  rank: idx + 1,
  ...c,
  trend: computeTrend(idx + 1, c.creator, lastCreatorMap),
}));

const generatedAt = new Date(current.metadata.generated_at);
const formattedDate = generatedAt.toLocaleDateString('es-MX', {
  year: 'numeric', month: 'long', day: 'numeric',
  hour: '2-digit', minute: '2-digit', timeZone: 'UTC', timeZoneName: 'short',
});
const generatedAtIso = generatedAt.toISOString();

const seoTitle = 'Ranking Mexa de Videojuegos en Kickstarter';
const seoDescription = 'Ranking Mexa de Videojuegos en Kickstarter: proyectos y estudios mexicanos con mayor recaudacion.';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL('/favicon.svg', Astro.site).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: seoTitle,
  description: seoDescription,
  inLanguage: 'es-MX',
  url: canonicalUrl,
  dateModified: generatedAtIso,
  about: {
    '@type': 'VideoGame',
    genre: 'Videojuegos',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Kickstarter Mexa Ranking',
    url: new URL('/kickstarter-mexa-ranking/', Astro.site).toString(),
  },
};
---

<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={seoDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{seoTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', stored || preferred);
      })();
    </script>
  </head>
  <body>
    <!-- Header -->
    <header class="site-header">
      <div class="container site-header__inner">
        <h1 class="site-header__title">
          Ranking <span>Mexa de Videojuegos</span> en Kickstarter
        </h1>
        <div style="display:flex;align-items:center;gap:1rem;">
          <span class="site-header__meta">Actualizado: {formattedDate}</span>
          <button class="theme-toggle" id="themeToggle" aria-label="Cambiar tema">🌙</button>
        </div>
      </div>
    </header>

    <!-- Main -->
    <main>
      <div class="container">
        <nav class="section-nav" aria-label="Secciones">
          <a href="#proyectos" class="section-nav__item section-nav__item--active">🎮 Principales Videojuegos Mexicanos</a>
          <a href="#creadores" class="section-nav__item">🏆 Principales Estudios/Creadores Mexicanos</a>
        </nav>

        <!-- Top Proyectos -->
        <section id="proyectos" class="ranking-section">
          <div class="ranking-section__header">
            <h2 class="ranking-section__title">Principales Videojuegos Mexicanos</h2>
            <span class="ranking-section__count">{projectRows.length} videojuegos mexicanos · categoría Videojuegos de Kickstarter</span>
          </div>
          {projectRows.length > 0 ? (
            <RankingTable kind="projects" projectRows={projectRows} />
          ) : (
            <div class="empty-state">
              Sin datos aún. Ejecuta el scraper para poblar el ranking.
            </div>
          )}
        </section>

        <!-- Top Creadores -->
        <section id="creadores" class="ranking-section">
          <div class="ranking-section__header">
            <h2 class="ranking-section__title">Principales Creadores / Estudios Mexicanos</h2>
            <span class="ranking-section__count">{creatorRows.length} creadores/estudios mexicanos · recaudación acumulada</span>
          </div>
          {creatorRows.length > 0 ? (
            <RankingTable kind="creators" creatorRows={creatorRows} />
          ) : (
            <div class="empty-state">
              Sin datos aún. Ejecuta el scraper para poblar el ranking.
            </div>
          )}
        </section>
      </div>
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="container site-footer__inner">
        <span>
          Datos: proyectos <strong>exitosos</strong> de videojuegos en Kickstarter con creadores de <strong>México (MX)</strong> ·
          Fuente: <a href="https://www.kickstarter.com" target="_blank" rel="noopener noreferrer">Kickstarter</a>
        </span>
        <span>
          Impulsado por <a href="https://github.com/edo0xff/kickstarter-mexa-statistics" target="_blank" rel="noopener noreferrer">kickstarter-mexa-statistics</a>
        </span>
      </div>
    </footer>

    <!-- Theme toggle script -->
    <script>
      const btn = document.getElementById('themeToggle')!;
      function applyTheme(theme: string) {
        document.documentElement.setAttribute('data-theme', theme);
        btn.textContent = theme === 'dark' ? '☀️' : '🌙';
        localStorage.setItem('theme', theme);
      }
      applyTheme(document.documentElement.getAttribute('data-theme') || 'light');
      btn.addEventListener('click', () => {
        const cur = document.documentElement.getAttribute('data-theme');
        applyTheme(cur === 'dark' ? 'light' : 'dark');
      });
    </script>
  </body>
</html>
