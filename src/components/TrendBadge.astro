---
import type { TrendResult } from '../lib/trend';

interface Props {
  trend: TrendResult;
}

const { trend } = Astro.props;
---

{trend.direction === 'up' && (
  <span class="trend trend--up" title={`+${trend.delta} posiciones`}>
    ▲ <span class="trend__delta">{trend.delta}</span>
  </span>
)}
{trend.direction === 'down' && (
  <span class="trend trend--down" title={`${trend.delta} posiciones`}>
    ▼ <span class="trend__delta">{Math.abs(trend.delta)}</span>
  </span>
)}
{trend.direction === 'same' && (
  <span class="trend trend--same" title="Sin cambio">—</span>
)}
{trend.direction === 'new' && (
  <span class="trend trend--new" title="Nueva entrada">✦</span>
)}
